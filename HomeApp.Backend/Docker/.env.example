# Schablone für Docker/.env (wird von docker-compose.yml gelesen).
# Kopieren: cp .env.example .env — dann Platzhalter ersetzen.
# Keine echten Secrets einchecken — .env ist git-ignoriert.

HOMEAPP_DATA_CONN=Host=host.docker.internal;Port=5060;Database=homeapp;Username=postgres;Password=<your-local-db-password>;Persist Security Info=True;

# OAuth (Resource Server)
OAuth__Authority=http://localhost:8080/realms/homeapp
OAuth__ValidAudiences__0=local-homeapp-api
